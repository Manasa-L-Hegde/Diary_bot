# Copy to .env, fill in, then: chmod 600 .env   (never commit .env)

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram numeric user IDs allowed to use the bot
# (get yours from @userinfobot). Everyone else is silently ignored.
ALLOWED_USER_IDS=

# Kannada speech-to-text (https://dashboard.sarvam.ai)
SARVAM_API_KEY=

# Structuring Kannada -> English ledger entries:
# Provide either GEMINI_API_KEY (Free: https://aistudio.google.com/app/apikey)
# OR ANTHROPIC_API_KEY (Paid: https://console.anthropic.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Claude fallback
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# Encryption key for stored audio and backups.
# Generate with:  python -m diary_bot.crypto genkey
# KEEP A COPY IN A PASSWORD MANAGER. If you lose it, audio and backups are unreadable.
DIARY_ENC_KEY=

# Optional
# SARVAM_STT_MODEL=saaras:v3
# DIARY_DATA_DIR=data
# DIARY_BACKUP_DIR=data/backups     # point at a Google Drive / Dropbox synced folder
# DIARY_TZ=Asia/Kolkata
# MAX_VOICE_SECONDS=30
# MAX_NOTES_PER_HOUR=40
